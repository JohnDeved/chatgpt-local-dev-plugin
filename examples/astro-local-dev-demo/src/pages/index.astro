---
const statuses = [
  ['Project link', 'Connected', 'Workspace mounted', 'mint'],
  ['Type safety', 'Strict', 'Astro + TypeScript', 'violet'],
  ['Preview port', '4321', 'Loopback only', 'cyan']
];
const workflow = [
  ['01', 'Open', 'Attach to the workspace and establish a clean local context.'],
  ['02', 'Build', 'Type-check and compile the experience without remote dependencies.'],
  ['03', 'Inspect', 'Verify content, interactions, console output, and network health.']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Local Orbit — a polished Astro local development dashboard." />
  <title>Local Orbit | Astro Dev Dashboard</title>
  <style>
    :root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;background:#060817;color:#f7f8ff;--panel:rgba(17,22,48,.76);--line:rgba(151,164,255,.18);--muted:#a8aecb;--mint:#70f6c8;--violet:#a88cff;--cyan:#72d9ff}
    *{box-sizing:border-box}body{min-width:320px;min-height:100vh;margin:0;background:radial-gradient(circle at 15% 12%,rgba(83,93,230,.23),transparent 30rem),radial-gradient(circle at 86% 36%,rgba(63,224,196,.12),transparent 25rem),#060817;overflow-x:hidden}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.32;background-image:radial-gradient(circle,#fff 0 1px,transparent 1.5px),radial-gradient(circle,#8997ff 0 1px,transparent 1.5px);background-position:0 0,45px 60px;background-size:110px 110px,160px 160px;mask-image:linear-gradient(#000,transparent 85%)}
    .shell{width:min(1120px,calc(100% - 36px));margin:auto;position:relative}header{min-height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
    .brand{display:flex;align-items:center;gap:11px;font-size:.83rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.mark{width:30px;aspect-ratio:1;border:1px solid rgba(112,246,200,.65);border-radius:50%;position:relative;box-shadow:inset 0 0 18px rgba(112,246,200,.2)}.mark:after{content:"";position:absolute;width:7px;aspect-ratio:1;border-radius:50%;background:var(--mint);top:-2px;right:3px;box-shadow:0 0 13px var(--mint)}
    .signal{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:.83rem}.pulse,.dot{width:8px;height:8px;border-radius:50%;background:var(--accent,var(--mint));box-shadow:0 0 14px var(--accent,var(--mint))}
    main{padding:88px 0 50px}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:76px;align-items:center}.eyebrow{margin:0 0 14px;color:var(--mint);font-size:.72rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}
    h1{margin:0;font-size:clamp(3.5rem,8vw,7.3rem);line-height:.86;letter-spacing:-.07em}h1 span{display:block;color:transparent;-webkit-text-stroke:1px rgba(220,224,255,.64)}.lede{max-width:620px;margin:30px 0 0;color:var(--muted);font-size:clamp(1rem,2vw,1.16rem);line-height:1.7}
    .orbit{position:relative;aspect-ratio:1;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;background:radial-gradient(circle,rgba(73,84,185,.2),rgba(8,11,28,.2) 60%);box-shadow:inset 0 0 75px rgba(105,121,255,.08)}.orbit:before,.orbit:after{content:"";position:absolute;border:1px solid var(--line);border-radius:50%}.orbit:before{inset:14%}.orbit:after{inset:30%}.core{z-index:1;width:34%;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#8390ff,#6851d7);font-size:.72rem;font-weight:900;letter-spacing:.15em;box-shadow:0 0 50px rgba(124,110,255,.5)}.satellite{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--mint);top:19%;right:20%;box-shadow:0 0 22px var(--mint)}.orbit small{position:absolute;bottom:12%;color:var(--muted);letter-spacing:.14em;text-transform:uppercase}
    .status-grid,.workflow-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.status-grid{margin-top:84px}.card,.control{border:1px solid var(--line);border-radius:20px;background:var(--panel);backdrop-filter:blur(14px)}.status{padding:23px}.status-top{display:flex;justify-content:space-between;align-items:center}.label{color:var(--muted);font-size:.76rem;letter-spacing:.1em;text-transform:uppercase}.value{display:block;margin:20px 0 5px;font-size:1.65rem}.detail{color:var(--muted);font-size:.84rem}.mint{--accent:var(--mint)}.violet{--accent:var(--violet)}.cyan{--accent:var(--cyan)}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin:100px 0 28px}h2{margin:0;font-size:clamp(2rem,4vw,3.1rem);letter-spacing:-.045em}.section-copy{max-width:400px;margin:0;color:var(--muted);line-height:1.6}.workflow{padding:26px;min-height:210px}.step{color:var(--mint);font:700 .72rem monospace;letter-spacing:.14em}.workflow h3{margin:50px 0 10px;font-size:1.25rem}.workflow p{margin:0;color:var(--muted);line-height:1.6;font-size:.92rem}
    .control{margin-top:84px;padding:clamp(24px,5vw,46px);display:flex;align-items:center;justify-content:space-between;gap:38px;overflow:hidden;position:relative}.control:after{content:"";width:240px;height:240px;position:absolute;right:-90px;background:var(--glow,rgba(112,246,200,.16));filter:blur(45px);border-radius:50%;transition:.3s;pointer-events:none}.control-copy{z-index:1}.control h2{font-size:clamp(1.6rem,3vw,2.25rem)}#mode-description{margin:10px 0 0;color:var(--muted);line-height:1.55}
    button{font:inherit;position:relative;z-index:1;min-width:178px;border:1px solid rgba(112,246,200,.5);border-radius:999px;padding:14px 19px;display:flex;align-items:center;justify-content:space-between;gap:18px;cursor:pointer;color:#f8fffd;background:rgba(112,246,200,.09);transition:.2s}button:hover{transform:translateY(-2px)}button:focus-visible{outline:3px solid #fff;outline-offset:4px}.track{width:42px;height:24px;padding:3px;border-radius:999px;background:rgba(112,246,200,.26)}.knob{display:block;width:18px;height:18px;border-radius:50%;background:var(--mint);transform:translateX(18px);transition:.3s;box-shadow:0 0 12px var(--mint)}button[aria-pressed=false]{border-color:rgba(168,140,255,.5);background:rgba(168,140,255,.08)}button[aria-pressed=false] .knob{transform:translateX(0);background:var(--violet);box-shadow:0 0 12px var(--violet)}
    footer{padding:34px 0 46px;color:#757d9d;font-size:.77rem;display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:90px}@media(max-width:800px){main{padding-top:60px}.hero{grid-template-columns:1fr;gap:56px}.orbit{width:min(440px,100%);justify-self:center}.status-grid,.workflow-grid{grid-template-columns:1fr}.workflow{min-height:0}.workflow h3{margin-top:28px}.section-head,.control{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</head>
<body>
<div class="shell">
  <header><div class="brand"><span class="mark" aria-hidden="true"></span>Local Orbit</div><div class="signal"><span class="pulse" aria-hidden="true"></span>System online</div></header>
  <main>
    <section class="hero" aria-labelledby="page-title"><div><p class="eyebrow">Astro development console</p><h1 id="page-title">Local <span>Orbit</span></h1><p class="lede">A focused command deck for moving from workspace to verified preview—fast, contained, and fully observable.</p></div><div class="orbit" aria-label="Local development orbit visualization"><span class="satellite" aria-hidden="true"></span><div class="core">LOCAL</div><small>Zero external dependencies</small></div></section>
    <section class="status-grid" aria-label="Development status">{statuses.map(([label,value,detail,tone])=><article class={`card status ${tone}`}><div class="status-top"><span class="label">{label}</span><span class="dot" aria-hidden="true"></span></div><strong class="value">{value}</strong><span class="detail">{detail}</span></article>)}</section>
    <section aria-labelledby="workflow-title"><div class="section-head"><div><p class="eyebrow">Three-point trajectory</p><h2 id="workflow-title">A tight local loop.</h2></div><p class="section-copy">Every stage stays close to the code, with explicit checks before the preview leaves your machine.</p></div><div class="workflow-grid">{workflow.map(([step,title,copy])=><article class="card workflow"><span class="step">{step}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
    <section class="control" id="control-panel" aria-labelledby="control-title"><div class="control-copy"><p class="eyebrow">Interactive control</p><h2 id="control-title">Preview atmosphere</h2><p id="mode-description" aria-live="polite">Focus mode is active. Interface signals are calm and precise.</p></div><button id="mode-toggle" type="button" aria-pressed="true" aria-describedby="mode-description"><span id="mode-label">Focus mode</span><span class="track" aria-hidden="true"><span class="knob"></span></span></button></section>
  </main>
  <footer><span>LOCAL ORBIT / ASTRO</span><span>Built for the loopback</span></footer>
</div>
<script>
  const button=document.querySelector('#mode-toggle');const label=document.querySelector('#mode-label');const description=document.querySelector('#mode-description');const panel=document.querySelector<HTMLElement>('#control-panel');
  button?.addEventListener('click',()=>{const active=button.getAttribute('aria-pressed')==='true';button.setAttribute('aria-pressed',String(!active));if(label)label.textContent=active?'Explore mode':'Focus mode';if(description)description.textContent=active?'Explore mode is active. Wider signals invite a more curious scan.':'Focus mode is active. Interface signals are calm and precise.';panel?.style.setProperty('--glow',active?'rgba(168,140,255,.24)':'rgba(112,246,200,.16)')});
</script>
</body>
</html>
